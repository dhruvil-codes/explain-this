# ==============================================================================
# ExplainThis — Environment Configuration Template
# Copy this file to .env.local and populate the required keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration (Required)
# ------------------------------------------------------------------------------
# Provider to use: "google" | "openai" | "anthropic" | "mock"
# Default is "google". "mock" runs with hand-written fixtures without an API key.
LLM_PROVIDER=google

# Fast model (used for analyze, simplify, visualize, and Show Me)
LLM_FAST_MODEL=gemini-2.5-flash

# Strong model (used for explore / sandbox HTML generation)
LLM_STRONG_MODEL=gemini-2.5-pro

# Provider API Keys (Set the key for your selected LLM_PROVIDER):
# If LLM_PROVIDER=google:
GOOGLE_GENERATIVE_AI_API_KEY=

# If LLM_PROVIDER=openai:
# OPENAI_API_KEY=

# If LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Explore / Sandbox Strategy (Optional, defaults to html)
# ------------------------------------------------------------------------------
# Strategy: "html" (dynamic sandbox HTML) | "spec" (declarative component renderer)
EXPLORE_STRATEGY=html

# ------------------------------------------------------------------------------
# 3. Persistent Share Storage & Rate Limiting (Optional in dev, Recommended for prod)
# ------------------------------------------------------------------------------
# If Upstash is not configured, the app falls back to in-memory/local JSON file store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 4. Global Kill-Switch & Safeguards (Optional)
# ------------------------------------------------------------------------------
# Optional daily request limit across all users
DAILY_REQUEST_CAP=1000

# ------------------------------------------------------------------------------
# 5. Deployment / CI (Optional)
# ------------------------------------------------------------------------------
# Vercel token if deploying via Vercel CLI / MCP
# VERCEL_TOKEN=
